<?xml version="1.0" encoding="utf-8"?>
<!--
  MyTube only needs public packages from nuget.org.
  <clear /> ignores any company/private feeds configured on the PC (for example feeds that need a
  personal access token), so restoring packages can't fail with 401 errors on another laptop.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
