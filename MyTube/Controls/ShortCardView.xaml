<?xml version="1.0" encoding="utf-8" ?>
<!-- 9:16 Shorts tile used in the Shorts shelf and on channel pages. -->
<ContentView
    x:Class="MyTube.Controls.ShortCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:MyTube.Models"
    x:DataType="m:VideoItem">

    <Border x:Name="Card" StrokeThickness="0" StrokeShape="RoundRectangle 10" Margin="0,0,8,0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOpen" />
        </Border.GestureRecognizers>
        <Grid>
            <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" />
            <BoxView VerticalOptions="End" HeightRequest="110" InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation"
                   VerticalOptions="End" Margin="10,0,10,10" />
            <Label Style="{StaticResource IconButton}" FontFamily="MaterialIcons" Text="&#xe5d4;" FontSize="20" TextColor="White"
                   HorizontalOptions="End" VerticalOptions="Start">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenu" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
</ContentView>
