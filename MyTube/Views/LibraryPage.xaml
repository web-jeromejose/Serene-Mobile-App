<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyTube.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:MyTube.Models"
    xmlns:vm="clr-namespace:MyTube.ViewModels"
    x:DataType="vm:LibraryViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="0,8,0,24">
            <!-- Top bar -->
            <Grid ColumnDefinitions="*,Auto,Auto" Padding="16,0,4,0">
                <Label Grid.Column="1" Style="{StaticResource IconButton}" Text="&#xe8b6;">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="2" Style="{StaticResource IconButton}" Text="&#xe8b8;">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Profile (local only) -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="16,0">
                <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{Binding AvatarColor}">
                    <Label Text="{Binding Initial}" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding DisplayName}" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Stats}" Style="{StaticResource Secondary}" />
                    <Label Text="No sign-in · everything stays on this phone" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Grid>

            <!-- History row -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                    <Label Text="History" Style="{StaticResource SectionTitle}" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="12,4" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" StrokeThickness="1">
                        <Label Text="View all" FontAttributes="Bold" FontSize="13" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistory" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
                <Label Text="Videos you watch will show up here." Style="{StaticResource Secondary}" FontSize="14" Margin="16,0"
                       IsVisible="{Binding HasHistory, Converter={StaticResource Not}}" />
                <CollectionView ItemsSource="{Binding History}" ItemsLayout="HorizontalList" HeightRequest="150" Margin="16,0,0,0"
                                HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasHistory}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:VideoItem">
                            <VerticalStackLayout WidthRequest="160" Spacing="6" Margin="0,0,10,0">
                                <Border HeightRequest="90" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" />
                                        <ProgressBar Progress="{Binding WatchProgress}" IsVisible="{Binding HasProgress}" VerticalOptions="End" HeightRequest="3" />
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVideo" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Playlists -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Padding="16,0,8,6">
                    <Label Text="Playlists" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Style="{StaticResource IconButton}" FontFamily="MaterialIcons" Text="&#xe145;">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NewPlaylistCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Playlists}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:PlaylistInfo">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="16,6">
                                <Border WidthRequest="96" HeightRequest="54" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                        <BoxView Color="#66000000" />
                                        <Label FontFamily="MaterialIcons" Text="{Binding Glyph}" FontSize="24" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding CountText}" Style="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlaylist" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView Style="{StaticResource Divider}" Margin="16,0" />

            <VerticalStackLayout Padding="16,0" Spacing="4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" HeightRequest="48">
                    <Label Style="{StaticResource Icon}" Text="&#xe2c6;" />
                    <Label Grid.Column="1" Text="Add videos" FontSize="15" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreate" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" HeightRequest="48">
                    <Label Style="{StaticResource Icon}" Text="&#xe8b8;" />
                    <Label Grid.Column="1" Text="Settings" FontSize="15" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
