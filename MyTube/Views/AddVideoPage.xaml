<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyTube.Views.AddVideoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:MyTube.Controls"
    xmlns:m="clr-namespace:MyTube.Models"
    xmlns:vm="clr-namespace:MyTube.ViewModels"
    x:DataType="vm:AddVideoViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="16">
            <Label Text="Create" FontSize="26" FontAttributes="Bold" />
            <Label Text="Add YouTube videos and Shorts by link, or upload your own videos. They're mixed randomly into Home and Shorts."
                   Style="{StaticResource Secondary}" FontSize="14" />

            <!-- Status -->
            <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding Status, Converter={StaticResource HasText}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="22" HeightRequest="22" />
                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="14" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Upload draft -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding Draft, Converter={StaticResource NotNull}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Add details" Style="{StaticResource SectionTitle}" />
                    <Border HeightRequest="180" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="Black">
                        <Image Source="{Binding Draft.ThumbnailSource}" Aspect="AspectFit" />
                    </Border>
                    <Border Style="{StaticResource InputBox}">
                        <Entry Placeholder="Title" Text="{Binding DraftTitle}" MaxLength="100" />
                    </Border>
                    <Border Style="{StaticResource InputBox}">
                        <Editor Placeholder="Description (optional)" Text="{Binding DraftDescription}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                    </Border>
                    <Border Style="{StaticResource InputBox}">
                        <Entry Placeholder="Category, e.g. Travel" Text="{Binding DraftCategory}" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Show in Shorts" FontAttributes="Bold" />
                            <Label Text="For vertical videos (detected automatically)" Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding DraftIsShort}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Discard" Style="{StaticResource SurfaceButton}" Command="{Binding DiscardDraftCommand}" />
                        <Button Grid.Column="1" Text="Publish" Style="{StaticResource AccentButton}" Command="{Binding PublishDraftCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Upload your own -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label FontFamily="MaterialIcons" Text="&#xe2c6;" FontSize="26" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Text="Upload your video" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Pick a video from your phone or record one. It's stored privately inside the app." Style="{StaticResource Secondary}" FontSize="13" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Choose video" Command="{Binding PickVideoCommand}" />
                        <Button Grid.Column="1" Text="Record" Style="{StaticResource SurfaceButton}" Command="{Binding RecordVideoCommand}" IsVisible="{Binding CanRecord}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- YouTube link -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label FontFamily="MaterialIcons" Text="&#xe037;" FontSize="26" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Text="Add a YouTube video or Short" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource InputBox}">
                            <Entry Placeholder="https://youtu.be/… or /shorts/…" Text="{Binding YouTubeLink}" Keyboard="Url" ReturnCommand="{Binding AddYouTubeCommand}" />
                        </Border>
                        <Button Grid.Column="1" Text="Paste" Style="{StaticResource SurfaceButton}" Command="{Binding PasteCommand}" />
                    </Grid>
                    <Button Text="Add to MyTube" Style="{StaticResource AccentButton}" Command="{Binding AddYouTubeCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Many links -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label FontFamily="MaterialIcons" Text="&#xe03b;" FontSize="26" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Text="Add a list of links" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource InputBox}">
                        <Editor Placeholder="One YouTube link per line" Text="{Binding BulkLinks}" AutoSize="TextChanges" MinimumHeightRequest="100" />
                    </Border>
                    <Button Text="Add all" Command="{Binding AddBulkCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Own hosted link -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label FontFamily="MaterialIcons" Text="&#xe157;" FontSize="26" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Text="Add your video from a link" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="A direct link to an .mp4 or .m3u8 you host (OneDrive/Dropbox direct links, your website, cloud storage…)."
                           Style="{StaticResource Secondary}" FontSize="13" />
                    <Border Style="{StaticResource InputBox}">
                        <Entry Placeholder="https://…/my-video.mp4" Text="{Binding OwnLink}" Keyboard="Url" />
                    </Border>
                    <Border Style="{StaticResource InputBox}">
                        <Entry Placeholder="Title" Text="{Binding OwnLinkTitle}" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Vertical video (show in Shorts)" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding OwnLinkIsShort}" />
                    </Grid>
                    <Button Text="Add video" Command="{Binding AddOwnLinkCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Recently added -->
            <Label Text="Recently added" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentlyAdded}" Margin="-12,0,-16,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:VideoItem">
                        <c:VideoRowView />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                <BindableLayout.EmptyView>
                    <Label Text="Nothing added yet." Style="{StaticResource Secondary}" FontSize="14" Margin="12,0" />
                </BindableLayout.EmptyView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
