<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<!-- iOS can only be built on a Mac (or from Visual Studio paired to a Mac).
		     On macOS it is added automatically; on a paired Windows PC pass -p:EnableIos=true. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(EnableIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MyTube</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Compile XAML at build time (compile-time XAML errors, faster startup, compiled bindings). -->
		<MauiXamlInflator>XamlC</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>SereneAppTube</ApplicationTitle>

		<!-- App Identifier. Also used as the HTTP Referer that identifies the app to the YouTube player. -->
		<ApplicationId>com.jerome.mytube</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<!-- Support 32-bit ARM devices such as the Redmi A3, plus 64-bit phones and x64 emulators. -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Release builds: a signed APK you can copy to a phone and install (switch to 'aab' for Google Play).
	     64-bit ARM covers modern phones; x64 covers the Android emulator. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<!-- One signing key for every PC: build-android.ps1 creates MyTube\signing the first time (OneDrive keeps it in sync).
	     Android only installs an update over an existing app if both are signed with the same key. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('$(MSBuildThisFileDirectory)signing\mytube.keystore')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildThisFileDirectory)signing\mytube.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>mytube</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>file:$(MSBuildThisFileDirectory)signing\password.txt</AndroidSigningStorePass>
		<AndroidSigningKeyPass>file:$(MSBuildThisFileDirectory)signing\password.txt</AndroidSigningKeyPass>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FF0033" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\loading.jpg" Color="#0F0F0F" Resize="false" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- Never package incomplete conversion temp files. -->
		<MauiAsset Remove="Resources\Raw\**\*.__compatible.mp4" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
